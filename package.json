    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shamir-secret-sharing": "0.0.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
