{
  "name": "phylactery",
  "private": true,
  "version": "0.1.0",
  "description": "Seal what you want to leave behind. Split the key among the people you trust. They open it together.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo:jar": "node --experimental-strip-types scripts/make-demo-jar.ts",
    "e2e": "node e2e/run.mjs",
    "screens": "node e2e/screens.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run check:offline && npm test && npm run build && npm run e2e",
    "serve": "node --experimental-strip-types server/dev.ts"
  },
  "dependencies": {
    "@fontsource/fragment-mono": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/rubik-wet-paint": "5.3.0",
    "@netlify/blobs": "11.1.7",
    "@noble/hashes": "2.4.0",
    "@scure/bip39": "2.4.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shamir-secret-sharing": "0.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
